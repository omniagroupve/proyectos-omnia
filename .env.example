# ─── Sitio ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://pix.com
NEXT_PUBLIC_BRAND=Pix
# Orígenes permitidos para /api/v1 (el frontend Vite en desarrollo)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ─── Supabase (DB + Auth) ─────────────────────────────────────────────────
# https://supabase.com/dashboard → Project Settings → API
# Región recomendada: São Paulo (sa-east-1), la más cercana a LatAm.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # SOLO servidor. Nunca exponer.

# ─── The Odds API (cuotas de 40+ casas) ───────────────────────────────────
# https://the-odds-api.com  ·  EMPIEZA CON EL PLAN DE $30 (20.000 créditos).
#
# Una llamada a /odds cuesta (nº mercados × nº regiones) créditos. Con el
# sondeo escalonado que ya está programado, las 29 ligas son 6.750 llamadas
# al mes, así que:
#
#   h2h + eu          →   6.750 créditos/mes   cabe de sobra en el de $30
#   h2h + eu,us       →  13.500                cabe en el de $30
#   3 mercados + eu,us→  40.500                aquí sí hace falta el de $59
#
# Por eso los valores por defecto son los de abajo y no los tres mercados:
# spreads y totals se encienden cuando el negocio los pague.
# `npm run doctor` calcula esto con TU configuración y te dice qué plan toca.
ODDS_API_KEY=
ODDS_API_BASE=https://api.the-odds-api.com/v4
ODDS_REGIONS=eu
ODDS_MARKETS=h2h

# ─── API-Football (fixtures, resultados oficiales, cobertura LatAm) ───────
# https://dashboard.api-football.com  · plan Pro ≈ $39/mo
APIFOOTBALL_KEY=
APIFOOTBALL_BASE=https://v3.football.api-sports.io

# ─── Motor de picks y parlays ─────────────────────────────────────────────
MIN_EDGE_PCT=2.0                    # No se publica nada por debajo de esto
MAX_PICKS_PER_DAY=25
KELLY_FRACTION=0.25                 # Kelly fraccionado. NO subir de 0.5.
DEVIG_METHOD=power                  # power | multiplicative | shin

# ─── IA (construcción y explicación de parlays) ───────────────────────────
# OPCIONAL. Sin key, Pix usa plantillas y cuesta $0: el producto funciona igual,
# sólo que los textos son más secos. Enciéndelo cuando ya factures.
# https://console.anthropic.com
ANTHROPIC_API_KEY=
# Narrar parlays es volumen alto y tarea simple → modelo barato.
AI_MODEL_NARRATION=claude-haiku-4-5
# Responder preguntas es sólo de Pro, volumen bajo → modelo bueno.
AI_MODEL_CHAT=claude-opus-5
# auto | templates | ai   ("templates" fuerza coste cero aunque haya key)
NARRATION_MODE=auto

# ─── Pagos: Lemon Squeezy (merchant of record) ────────────────────────────
# Stripe suspende cuentas de este vertical. LS/Paddle absorben ese riesgo.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_ELITE=

# ─── Frenos de seguridad ──────────────────────────────────────────────────
# PIX_PAUSE_EXTERNAL=1 → ninguna llamada de pago sale a la red (Odds API,
#   API-Football, Anthropic). Úsalo en desarrollo y cuando dejes trabajar a un
#   agente: un bucle mal escrito no puede gastarte los créditos del mes.
# TELEGRAM_DRY_RUN=1 → el broadcast calcula a quién enviaría y NO envía nada.
#   Déjalo en 1 en cualquier entorno que no sea producción: ejecutarlo en local
#   con las claves de producción manda mensajes reales a personas reales.
PIX_PAUSE_EXTERNAL=1
TELEGRAM_DRY_RUN=1

# ─── Cron ─────────────────────────────────────────────────────────────────
CRON_SECRET=                        # openssl rand -hex 32
#
# EL RELOJ VIVE EN GITHUB ACTIONS, no aquí. Vercel Hobby sólo ejecuta un cron
# al día, que no sirve para sondear cada 2h. En GitHub → Settings → Secrets
# and variables → Actions hay que crear DOS secretos:
#
#   PIX_URL       https://tu-dominio.com   (sin barra al final)
#   CRON_SECRET   exactamente el mismo de arriba
#
# Si no coinciden, cada ejecución falla con 401. Paso a paso en
# docs/encender-el-motor.md.

# ─── Monetización del plan Free ───────────────────────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=         # ca-pub-XXXXXXXX (opcional)
NEXT_PUBLIC_AFFILIATE_ENABLED=true

# ─── Telegram ─────────────────────────────────────────────────────────────
# @BotFather → /newbot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=            # openssl rand -hex 32
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=  # sin la @
TELEGRAM_CHANNEL_PUBLIC=            # @micanalpublico  (picks diferidos)
TELEGRAM_CHANNEL_PRO=               # -1001234567890   (canal privado Pro)
